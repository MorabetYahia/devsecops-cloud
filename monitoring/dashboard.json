{
  "title": "DevSecOps Cloud — Application",
  "uid": "devsecops-app",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    { "type": "stat", "title": "Pods prêts", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(kube_pod_status_ready{namespace=\"default\",condition=\"true\",pod=~\"devsecops-app.*\"})" } ] },
    { "type": "stat", "title": "Requêtes / s", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "targets": [ { "refId": "A", "expr": "sum(rate(flask_http_request_total[1m]))" } ] },
    { "type": "stat", "title": "Erreurs 4xx/5xx (15 min)", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 } },
      "targets": [ { "refId": "A", "expr": "sum(increase(flask_http_request_total{status=~\"4..|5..\"}[15m])) or vector(0)" } ] },
    { "type": "stat", "title": "Latence p95", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(flask_http_request_duration_seconds_bucket[5m])) by (le))" } ] },
    { "type": "timeseries", "title": "Requêtes par seconde, par code HTTP", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [ { "refId": "A", "expr": "sum(rate(flask_http_request_total[1m])) by (status)", "legendFormat": "HTTP {{status}}" } ] },
    { "type": "timeseries", "title": "Requêtes par seconde, par pod", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [ { "refId": "A", "expr": "sum(rate(flask_http_request_total[1m])) by (pod)", "legendFormat": "{{pod}}" } ] },
    { "type": "timeseries", "title": "CPU par pod", "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3 } },
      "targets": [ { "refId": "A", "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"default\",container=\"app\"}[2m])) by (pod)", "legendFormat": "{{pod}}" } ] },
    { "type": "timeseries", "title": "Mémoire par pod", "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [ { "refId": "A", "expr": "sum(container_memory_working_set_bytes{namespace=\"default\",container=\"app\"}) by (pod)", "legendFormat": "{{pod}}" } ] }
  ]
}
